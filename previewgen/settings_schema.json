{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://previewgen.app/schema/settings.json",
  "title": "PreviewGen Settings",
  "type": "object",
  "description": "Canonical settings schema shared between frontend and backend",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Settings schema version for migration"
    },
    "inputFolder": {
      "type": "string",
      "default": "",
      "description": "Selected input folder path"
    },
    "outputFolder": {
      "type": "string",
      "default": "",
      "description": "Selected output folder path"
    },
    "sameFolder": {
      "type": "boolean",
      "default": false,
      "description": "Whether to save output alongside input"
    },
    "invertTriangles": {
      "type": "boolean",
      "default": true,
      "description": "Invert diagonal split direction"
    },
    "solidColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#FFFFFF",
      "description": "Solid triangle color (hex)"
    },
    "logoPath": {
      "type": "string",
      "default": "",
      "description": "Custom logo file path"
    },
    "logoScale": {
      "type": "number",
      "minimum": 20,
      "maximum": 300,
      "default": 100,
      "description": "Logo scale percentage"
    },
    "logoOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 90,
      "description": "Logo opacity percentage"
    },
    "logoPosX": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 88,
      "description": "Logo X position percentage"
    },
    "logoPosY": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 5,
      "description": "Logo Y position percentage"
    },
    "text": {
      "type": "string",
      "maxLength": 100,
      "default": "100% TRANSPARENT",
      "description": "Banner text (max 100 chars)"
    },
    "textPosX": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 5,
      "description": "Text X position percentage"
    },
    "textPosY": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 5,
      "description": "Text Y position percentage"
    },
    "textColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#FFFFFF",
      "description": "Text color (hex)"
    },
    "fontPath": {
      "type": "string",
      "default": "",
      "description": "Custom font file path"
    },
    "fontScale": {
      "type": "number",
      "minimum": 20,
      "maximum": 300,
      "default": 100,
      "description": "Font scale percentage"
    },
    "hasOutline": {
      "type": "boolean",
      "default": true,
      "description": "Whether text has outline"
    },
    "outlineColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#000000",
      "description": "Outline color (hex)"
    },
    "outlineThickness": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2,
      "description": "Outline thickness in pixels"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 90,
      "description": "Text opacity percentage"
    },
    "yaw": {
      "type": "number",
      "minimum": -360,
      "maximum": 360,
      "default": 45,
      "description": "3D yaw rotation in degrees"
    },
    "pitch": {
      "type": "number",
      "minimum": -85,
      "maximum": 85,
      "default": 30,
      "description": "3D pitch elevation in degrees"
    },
    "modelColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#7882A0",
      "description": "3D model base color (hex)"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light",
      "description": "UI theme"
    },
    "overwritePolicy": {
      "type": "string",
      "enum": [
        "rename",
        "skip",
        "overwrite"
      ],
      "default": "rename",
      "description": "File overwrite behavior"
    },
    "outputWidth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192,
      "default": 0,
      "description": "Export width in pixels (0 = native / renderer default)"
    },
    "outputHeight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192,
      "default": 0,
      "description": "Export height in pixels (0 = native / renderer default)"
    },
    "desktopNotifications": {
      "type": "boolean",
      "default": false,
      "description": "Allow optional operating-system batch completion notifications"
    }
  },
  "required": [
    "schemaVersion"
  ]
}
