# Top-level runtime dependencies (intentionally loose bounds).
#
# Reproducible, hash-pinned installs use the generated lock file instead:
#
#   pip install --require-hashes -r requirements-lock.txt          # runtime
#   pip install --require-hashes -r requirements-dev-lock.txt      # runtime + build tooling
#
# Regenerate the locks (universal: cross-platform markers + SHA-256 hashes) with:
#
#   uv pip compile --universal --generate-hashes --python-version 3.12 \
#       --output-file requirements-lock.txt requirements.in
#   uv pip compile --universal --generate-hashes --python-version 3.12 \
#       --output-file requirements-dev-lock.txt requirements-dev.in
